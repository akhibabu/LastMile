# Copy to backend/.env and frontend/.env as needed.

# --- Backend ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lastmile:lastmile@localhost:5432/lastmile
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

RESEND_API_KEY=
FROM_EMAIL=noreply@lastmile.local
FROM_NAME=LastMile

LOCATION_UPDATE_INTERVAL=30000
LOCATION_STALE_THRESHOLD=300000

# Optional Nominatim user agent override
GEOCODING_USER_AGENT=LastMileDelivery/1.0 (local-dev)
GEOCODING_API_KEY=

# Optional: create the first admin on `npm run db:seed`
# Leave blank to skip. Never commit real passwords.
SEED_ADMIN_NAME=Akhil
SEED_ADMIN_EMAIL=admin@lastmile.local
SEED_ADMIN_PASSWORD=Akhibabu@105

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:4000/api
